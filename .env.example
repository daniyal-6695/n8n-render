# n8n Configuration for SaaS Deployment

# Basic Authentication
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-this-password

# Host Configuration (Update with your Render URL)
N8N_HOST=your-app-name.onrender.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://your-app-name.onrender.com/

# Database Configuration (PostgreSQL recommended for production)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=your-database-host
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=your-db-password

# Security
N8N_ENCRYPTION_KEY=your-secure-encryption-key-min-10-chars

# Execution Configuration
EXECUTIONS_PROCESS=main
EXECUTIONS_TIMEOUT=300
EXECUTIONS_TIMEOUT_MAX=3600
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true

# Webhook Configuration
N8N_PAYLOAD_SIZE_MAX=16
WEBHOOK_TUNNEL_URL=

# Timezone
GENERIC_TIMEZONE=America/New_York

# Editor Configuration
N8N_EDITOR_BASE_URL=https://your-app-name.onrender.com

# Performance
N8N_CONCURRENCY_PRODUCTION_LIMIT=10

# Logging
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console

# External Hooks (for monitoring and analytics)
# EXTERNAL_HOOK_FILES=

# Additional Features
N8N_PERSONALIZATION_ENABLED=true
N8N_VERSION_NOTIFICATIONS_ENABLED=true
N8N_DIAGNOSTICS_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false
